<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/image_icona_posizione"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="Icona Posizione"
        android:src="@android:drawable/ic_dialog_map"
        android:layout_marginEnd="16dp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_nome_posizione"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome Luogo (Es. Casa)"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_coordinate_posizione"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lat: 0.0, Lng: 0.0"
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</LinearLayout>